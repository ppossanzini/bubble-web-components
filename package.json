{
  "name": "@bubble/web-components",
  "version": "0.2.0",
  "description": "A material based web component library",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bubble.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./typography.css": "./dist/typography.css",
    "./design-system.json": "./dist/design-system.json"
  },
  "scripts": {
    "dev": "npm run typography && vite --host 127.0.0.1",
    "dev:site": "npm run typography && vite --config vite.site.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typography && npm run typecheck && vite build && tsc --emitDeclarationOnly && cp src/tokens.css src/design-system.json dist/",
    "build:site": "npm run typography && vite build --config vite.site.config.ts",
    "typography": "node scripts/typography.mjs",
    "format": "prettier --write src demo index.html package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tabler/icons": "^3.51.0",
    "@tabler/icons-webfont": "^3.51.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@tabler/icons": "3.51.0",
    "playwright": "^1.65.0",
    "prettier": "^3.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
